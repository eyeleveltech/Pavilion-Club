# The Pavilion Club — Environment Configuration Template
# Copy this file to .env and fill in your local or production values.
# NEVER commit your real .env file with secrets to Git.

# Database: PostgreSQL 16+ with btree_gist extension
DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/pavilion

# Application URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Security
SESSION_SECRET=change_this_to_a_random_32_character_secret_string
API_KEY_PEPPER=change_this_to_a_random_pepper_string

# Payment Gateway (Razorpay - deferred for live go-live cash/venue mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=

# Notifications & Messaging Providers
WHATSAPP_API_KEY=
SMS_API_KEY=
SENTRY_DSN=

# Email Dispatch Provider 1: Resend API (Fallback)
RESEND_API_KEY=
EMAIL_FROM="The Pavilion Club <onboarding@resend.dev>"

# Email Dispatch Provider 2: Gmail SMTP Engine (Primary live dispatch)
GMAIL_USER=thepavilionclub.adyar@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
EMAIL_SMTP_USER=thepavilionclub.adyar@gmail.com
EMAIL_SMTP_PASSWORD=your_16_digit_app_password
