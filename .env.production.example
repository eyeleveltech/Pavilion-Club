# ==============================================================================
# Pavilion Club - Production Environment Configuration (.env.production)
# Keep this file OUT of version control. Set on Hostinger KVM VPS.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
DOMAIN=pavilionclub.in

# 1. PostgreSQL 16 Database
# Internal Docker Compose network or external managed database:
POSTGRES_USER=pavilion_app
POSTGRES_PASSWORD=generate_a_strong_random_password_here_32chars
POSTGRES_DB=pavilion
DATABASE_URL=postgres://pavilion_app:generate_a_strong_random_password_here_32chars@postgres:5432/pavilion

# 2. Cryptographic Secrets & Peppers (generate using: openssl rand -hex 32)
# High-entropy secret for staff Argon2id session tokens:
SESSION_SECRET=e7b4c91a82f3d6015b74c2e98a104f32c918374d6105f2b84a91c3d705e4b2a1

# SHA-256 pepper for partner API keys (Turf Town):
PARTNER_PEPPER=a81f304b92c81d7402e847c1a93b5d207c4918e3a205d61f84b72901c3e5a4b7

# SHA-256 pepper for DPDP customer phone hashing:
PHONE_PEPPER=5c2a1b9e84d73012f6849b20e17a35c8914028d7a16e53c4b92810f3a745d2e9

# AES-256-GCM Key for Encrypted Backups before off-box export:
BACKUP_ENCRYPTION_KEY=94b81c2d03e7a65f12b84701d93c5e28a41928f7c105e6b34a7810d2e5b4a3c9

# 3. WhatsApp Business & SMS Notification Gateway
# Provider: Gupshup / Meta Cloud API
WHATSAPP_API_KEY=your_gupshup_or_meta_api_key
WHATSAPP_PHONE_NUMBER_ID=your_registered_whatsapp_phone_number_id
WHATSAPP_TEMPLATE_NAMESPACE=pavilion_club

# SMS Fallback Gateway (e.g. Fast2SMS / Twilio)
SMS_GATEWAY_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=PVLION

# 4. Error Tracking & Observability (Sentry with DPDP PII Scrubbing)
SENTRY_DSN=https://your_sentry_dsn@o123456.ingest.sentry.io/7890123
SENTRY_ENVIRONMENT=production

# 5. Uptime & Alerting Webhook (alerting to WhatsApp / Telegram / PagerDuty)
ALERT_WEBHOOK_URL=https://api.telegram.org/bot<token>/sendMessage
ALERT_CHAT_ID=-1001234567890
